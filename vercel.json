{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/import",
      "destination": "/api/import"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/auth/$1"
    },
    {
      "source": "/profile/(.*)",
      "destination": "/api/profile/$1"
    },
    {
      "source": "/profile",
      "destination": "/api/profile"
    },
    {
      "source": "/balance/(.*)",
      "destination": "/api/balance/$1"
    },
    {
      "source": "/balance",
      "destination": "/api/balance"
    },
    {
      "source": "/transactions/(.*)",
      "destination": "/api/transactions/$1"
    },
    {
      "source": "/analysis/(.*)",
      "destination": "/api/analysis/$1"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api/reports/$1"
    }
  ]
}
