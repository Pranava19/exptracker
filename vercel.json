{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/import",
      "destination": "/api/import"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/auth/$1"
    },
    {
      "source": "/transactions/(.*)",
      "destination": "/api/transactions/$1"
    },
    {
      "source": "/analysis/(.*)",
      "destination": "/api/analysis/$1"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api/reports/$1"
    }
  ]
}
